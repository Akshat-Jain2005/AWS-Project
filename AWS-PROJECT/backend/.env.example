# Google Identity Services: public Web application client ID, no client secret.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Comma-separated Gmail accounts or Workspace emails/domains.
# Domain entries require a matching Google-verified hd claim.
OPERATOR_ALLOWLIST=operator@gmail.com

# Keep disabled on deployed services. Enables known local test tokens and mock delivery.
DEV_MODE=0
# Set to the actual frontend origin if frontend and backend use different origins.
CORS_ORIGINS=http://localhost:5173

# Amazon DynamoDB — stores email/password accounts (required for password sign-in).
# Create the table once with: python create_table.py
DDB_TABLE_NAME=biosentinel
# Leave blank to use real AWS DynamoDB; set to http://localhost:8000 for DynamoDB Local.
DDB_ENDPOINT_URL=
# Signs stateless session tokens for email/password sign-in. MUST be set in
# production (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))").
# Password sign-in is disabled when this is blank (outside DEV_MODE).
SESSION_SECRET=

# External delivery and AI are opt-in.
USE_AWS_SNS=0
USE_AI_ALERTS=0

# Private S3 bucket for report photos; configure POST CORS for the frontend origin.
# Empty means photo upload is unavailable; readings can still be submitted.
REPORT_PHOTO_BUCKET=
